# ─── Database ───────────────────────────────────────────
# Vercel Postgres (Neon) — auto-set when you add a Postgres store
DATABASE_URL=
# Or use these Vercel-managed equivalents:
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# ─── Auth ───────────────────────────────────────────────
# REQUIRED in production — generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRY=24h

# ─── Logging ────────────────────────────────────────────
# warn | info | debug  (defaults to 'warn' in production)
LOG_LEVEL=warn

# ─── WebSocket (optional) ──────────────────────────────
# If you run a separate WS server, set its URL here.
# Without this, WebSocket features are silently disabled on Vercel.
# NEXT_PUBLIC_WS_URL=wss://your-ws-server.example.com
